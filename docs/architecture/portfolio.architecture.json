  "cards": [
    {
      "dot": "rose",
      "title": "Edge",
      "items": [
        "X-API-Key or Bearer must match GATEWAY_SECURITY_APIKEY",
        "OIDC_ISSUER_URI is optional and off when blank",
        "Compose sets REDIS_URL to redis://redis:6379"
      ]
    },
    {
      "dot": "emerald",
      "title": "Apps",
      "items": [
        "Fourteen Boot apps plus libs/shared",
        "P2 and P8 use in-memory H2 until a Postgres profile is on",
        "Empty design and Kotlin corpora are refused"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional",
      "items": [
        "ChatClient runs only when a ChatModel bean and an API key are both set",
        "TLS nginx on :8443 is the tls compose profile",
        "No Prometheus or Grafana service in compose"
      ]
    }
  ]
