# Copy to infra/compose/.env (gitignored) before stack up.
# Required for gateway + Grafana. App keys are optional for offline paths.

GATEWAY_SECURITY_APIKEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Gateway rate limit (prod compose defaults to redis://redis:6379)
REDIS_URL=redis://redis:6379

# Optional OIDC resource-server path on the gateway (off when blank)
OIDC_ISSUER_URI=

# Optional live ChatClient (apps stay offline unless both are set)
OPENAI_API_KEY=
SPRING_AI_MODEL_CHAT=none

# Postgres for P2/P8 when using --profile postgres or --profile prod
DESIGN_RAG_SPRING_PROFILES=
DESIGN_RAG_JDBC_URL=
DESIGN_RAG_JDBC_USER=postgres
DESIGN_RAG_JDBC_PASSWORD=design
PAPER_LAB_SPRING_PROFILES=
PAPER_LAB_JDBC_URL=
PAPER_LAB_JDBC_USER=postgres
PAPER_LAB_JDBC_PASSWORD=papers

# Prod Postgres (optional; or use docker-compose.prod.yml + --profile prod)
# DESIGN_RAG_SPRING_PROFILES=pgvector
# DESIGN_RAG_JDBC_URL=jdbc:postgresql://design-rag-db:5432/design
# PAPER_LAB_SPRING_PROFILES=pgvector
# PAPER_LAB_JDBC_URL=jdbc:postgresql://paper-lab-db:5432/papers

GATEWAY_DOWNSTREAM_URL=http://yagni-copilot:8081

YAGNI_API_KEY=
DESIGN_RAG_API_KEY=
QUALITY_GATE_API_KEY=
SPEC_ORCH_API_KEY=
OBSERVABILITY_API_KEY=
MCP_BROKER_API_KEY=
APP_FACTORY_API_KEY=
PAPER_LAB_API_KEY=
ARCHITECT_API_KEY=
MULTIMODAL_DESK_API_KEY=
KOTLIN_RAG_API_KEY=
AI_HARNESS_API_KEY=
SECURITY_REVIEW_API_KEY=
MCP_REMOTE_URL=
