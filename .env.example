# Portfolio-wide env placeholders — copy to .env (gitignored)
# Never commit real values.

# Model providers (pick what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SPRING_AI_OPENAI_API_KEY=

# Local / offline
OLLAMA_BASE_URL=http://localhost:11434

# Data stores (Compose defaults — adjust per machine)
POSTGRES_URL=jdbc:postgresql://localhost:5432/portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Edge / gateway (P10)
GATEWAY_PORT=8080
JWT_ISSUER_URI=
